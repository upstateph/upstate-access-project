# Raw data pulls (large; regenerate with data-pipeline scripts)
data/raw/
*.zip

# De-identified usage telemetry (local only — publish only the k-anonymized rollup)
data/usage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.Python
*.egg-info/

# Verified sensitive-facility seed lists (handle deliberately; keep only the template)
data-pipeline/seeds/*.csv
!data-pipeline/seeds/template.csv

# Personal planning docs — contain personal-network details; keep local only
outreach-letters-full-set.md
project-context.md

# Secrets / API keys
.env
*.key
census_api_key.txt

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Node (dashboard tooling, if any)
node_modules/

# Keep processed outputs tracked (small JSON the dashboard reads),
# but ignore any scratch exports
data/processed/*.tmp

# Build artifacts
dist/
deploy/artifact.html
deploy/lite/artifact.html
deploy/artifact-access.html
