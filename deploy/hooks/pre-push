#!/usr/bin/env bash
#
# Publish gh-pages whenever main is pushed, so the mirror cannot drift again.
#
# WHY pre-push AND NOT post-push. Git has no post-push hook. pre-push is the
# only hook that fires on a push, and it runs BEFORE the refs land on the
# remote. Publishing straight from it would stamp a sha into the gh-pages
# commit message that is not yet on origin, and would publish anyway if the
# push were then rejected. So this hook does not publish inline: it queues the
# publish to start a few seconds later, in the background, by which time the
# push it belongs to has either landed or failed.
#
# The delay is a race, not a guarantee. It is the honest cost of git not having
# the hook this wants. The failure it can produce is small and self-correcting:
# gh-pages briefly ahead of a push that was rejected, fixed by the next publish,
# and caught within seven days by check_live_matches_local in weekly_debug.
#
# NOT BLOCKING. This hook always exits 0. Blocking a code push because a deploy
# step failed teaches you to reach for --no-verify, and a bypassed hook protects
# nothing. Failures are loud in the log instead, and the weekly --live run is
# the real backstop.
#
# NO RECURSION. publish_pages.py pushes to refs/heads/gh-pages, which re-enters
# this hook; the ref test below ignores everything that is not main, so the
# second entry falls straight through.
#
# Installed by deploy/install_hooks.sh. Hooks live outside version control, so
# a fresh clone has to run that once.
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
LOG="$REPO/.git/uap-publish.log"
ZERO="0000000000000000000000000000000000000000"

PY="$REPO/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || true)"

pushing_main=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion, not a publish
  pushing_main=1
done

[ "$pushing_main" -eq 1 ] || exit 0

if [ -z "$PY" ]; then
  echo "[uap] pre-push: no python found, skipping the gh-pages publish." >&2
  echo "[uap] run deploy/publish_pages.py by hand once python is available." >&2
  exit 0
fi

# Escape hatch for testing the hook, and for the rare push you do not want
# mirrored: UAP_SKIP_PUBLISH=1 git push
if [ "${UAP_SKIP_PUBLISH:-0}" = "1" ]; then
  echo "[uap] pre-push: UAP_SKIP_PUBLISH=1, not publishing gh-pages."
  exit 0
fi

if [ "${UAP_HOOK_DRY_RUN:-0}" = "1" ]; then
  echo "[uap] pre-push: would queue a gh-pages publish for this push of main."
  exit 0
fi

{
  echo
  echo "=== queued $(date '+%Y-%m-%d %H:%M:%S') by pre-push, for a push of main"
} >> "$LOG"

nohup sh -c "sleep 6; '$PY' '$REPO/deploy/publish_pages.py' >> '$LOG' 2>&1" \
  >/dev/null 2>&1 &

echo "[uap] gh-pages publish queued (starts in ~6s, takes a few minutes)."
echo "[uap] watch it: tail -f .git/uap-publish.log"
exit 0
